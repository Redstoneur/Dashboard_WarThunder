# Copiez ce fichier vers `.env` à la racine du projet pour configurer docker-compose.
# `docker compose --env-file .env up` (ou simplement `docker compose up` si le fichier
# s'appelle déjà `.env`).

# ------------------------------------------------------------------
# Serveur War Thunder (la machine sur laquelle le jeu tourne)
# ------------------------------------------------------------------
# Sous Docker Desktop (Windows/Mac), "host.docker.internal" permet de joindre le jeu
# lancé sur la machine hôte. Sous Linux, docker-compose.yml mappe déjà cet alias vers
# la passerelle hôte (extra_hosts). Remplacez par l'IP LAN de la machine de jeu si besoin.
WAR_THUNDER_IP=host.docker.internal
WAR_THUNDER_PORT=8111
WAR_THUNDER_TIMEOUT_MS=5000
WAR_THUNDER_IMG_TIMEOUT_MS=10000

# Renvoyer des données par défaut (au lieu d'une erreur 502) quand le jeu est injoignable/off.
UPSTREAM_FALLBACK_ENABLED=true

# ------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------
BACKEND_PORT=8000
CORS_ORIGIN=*
LOG_LEVEL=info

# ------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------
FRONTEND_PORT=8080
# Laisser vide pour utiliser le reverse-proxy Nginx intégré (/api -> backend).
VITE_API_BASE_URL=
