# Adresse et port d'écoute du serveur API
HOST=0.0.0.0
PORT=8000

# Adresse et port du serveur War Thunder (la machine sur laquelle le jeu tourne)
WAR_THUNDER_IP=localhost
WAR_THUNDER_PORT=8111

# Timeout (ms) des appels vers le serveur War Thunder
WAR_THUNDER_TIMEOUT_MS=5000
WAR_THUNDER_IMG_TIMEOUT_MS=10000

# Si "true", les endpoints renvoient des données par défaut (valid=false) au lieu
# d'une erreur 502 lorsque le serveur War Thunder est injoignable/désactivé.
UPSTREAM_FALLBACK_ENABLED=true

# CORS: liste d'origines autorisées séparées par des virgules, ou "*" pour tout autoriser
CORS_ORIGIN=*

# Niveau de log: debug | info | warn | error
LOG_LEVEL=info
