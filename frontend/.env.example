# URL de base de l'API backend. Laisser vide pour utiliser des requêtes relatives
# (recommandé en dev avec le proxy Vite, et en prod derrière Nginx).
VITE_API_BASE_URL=

# Cible du proxy Vite en développement (`npm run dev`) pour les requêtes vers /api/*.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
VITE_DEV_PORT=5173

# Intervalles de polling (ms)
VITE_POLL_STATUS_MS=5000
VITE_POLL_SPEED_MS=200
VITE_POLL_ALTITUDE_MS=500
VITE_POLL_COMPASS_MS=100
VITE_POLL_GYROSCOPE_MS=100
VITE_POLL_MAP_MS=400

# Plages d'affichage des jauges
VITE_SPEED_MIN=0
VITE_SPEED_MAX=1000
VITE_ALTITUDE_MIN=0
VITE_ALTITUDE_MAX=3000
VITE_ALTITUDE_ALARM_INTERMITTENT_M=100
VITE_ALTITUDE_ALARM_CONTINUOUS_M=50
